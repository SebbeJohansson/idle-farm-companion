# Copy to .env to change any of these.
LAYA_VERSION=v0.3.22
LAYA_PORT=8000
# CPU threads for inference: set to your physical core count (not
# logical). 4 → 12 on a 12-core Threadripper cut a biome check from ~6s to ~2.6s.
LAYA_THREADS=4
# Set to require `Authorization: Bearer <key>` on every request.
LAYA_API_KEY=
LAYA_LOG_LEVEL=info

# Image model for sprites (stable-diffusion.cpp). Default: PublicPrompts'
# All-In-One-Pixel-Model, an SD 1.5 fine-tune for pixel art (CreativeML
# OpenRAIL-M). Any SD 1.5 .safetensors/.ckpt URL works.
ART_MODEL_URL=https://huggingface.co/PublicPrompts/All-In-One-Pixel-Model/resolve/main/Public-Prompts-Pixel-Model.ckpt
ART_MODEL_FILE=Public-Prompts-Pixel-Model.ckpt
ART_PORT=7860
