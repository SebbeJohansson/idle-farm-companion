# Copy to .env to change any of these.
LAYA_VERSION=v0.3.22
LAYA_PORT=8000
# CPU threads for inference: set to your physical core count (not
# logical). 4 → 12 on a 12-core Threadripper cut a biome check from ~6s to ~2.6s.
LAYA_THREADS=4
# Set to require `Authorization: Bearer <key>` on every request.
LAYA_API_KEY=
LAYA_LOG_LEVEL=info

# Port for the art service (SDXL + pixel-art-xl, see compose.yaml).
ART_PORT=7860

# The bridge: one local port for the game (see Caddyfile).
BRIDGE_PORT=7870
# Where the bridge finds Ollama, and which model the game should use.
OLLAMA_UPSTREAM=host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
